{
  "buildCommand": "pnpm run build",
  "outputDirectory": "artifacts/api-failure-simulator/dist/public",
  "installCommand": "pnpm install",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
